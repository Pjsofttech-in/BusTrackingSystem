spring.application.name=BusTrackingSystem
##MySQL datasource for testing purpose add your mysql credentials.
spring.datasource.url=jdbc:mysql://localhost:3306/bustrackdb?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=root
# Hibernate / JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:*}
#baseUrl
app.base-url=http://localhost:9090
# ─── CORS ──────────────────────────────────────────────────────────────────
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:4173,https://shrishahuprabodhini.in/bustricking}
